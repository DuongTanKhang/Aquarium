generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  TOKEN_REFRESHED
  TOKEN_REFRESH_FAILED
  TOKEN_REUSE_DETECTED
  LOGGED_OUT
  LOGGED_OUT_ALL
  PASSWORD_CHANGED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PHONE_VERIFICATION_SENT
  PHONE_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_SETUP_STARTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_CREATED
  MFA_CHALLENGE_FAILED
  MFA_CHALLENGE_SUCCEEDED
  MFA_RECOVERY_CODES_REGENERATED
}

enum EmailTokenType {
  VERIFY_EMAIL
  VERIFY_PHONE
  PASSWORD_RESET
}

enum ProductType {
  FISH
  ACCESSORY
  FOOD
  AQUARIUM
  PLANT
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  ACH
  VENMO
  COD
  BANK_TRANSFER
  PAYOS
  VNPAY
  MOMO
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnRequestType {
  REFUND
  RETURN
  EXCHANGE
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  COMPLETED
}

enum InventoryTransactionType {
  IMPORT
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique
  passwordHash        String
  fullName            String
  phone               String?
  address             String?
  avatarUrl           String?
  role                UserRole          @default(CUSTOMER)
  status              UserStatus        @default(ACTIVE)
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime          @default(now())
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  mfaEnabled          Boolean           @default(false)
  mfaSecretEncrypted  String?
  mfaPendingEncrypted String?
  mfaVerifiedAt       DateTime?
  mfaLastUsedStep     Int?
  orders              Order[]
  refreshTokens       RefreshToken[]
  authEvents          AuthEvent[]
  emailTokens         EmailToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]
  returnRequests      ReturnRequest[]
  favorites           Favorite[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  familyId      String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}

model AuthEvent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @db.Uuid
  type      AuthEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

model EmailToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  type       EmailTokenType
  tokenHash  String         @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@index([expiresAt])
  @@map("email_tokens")
}

model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("mfa_challenges")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, name])
  @@map("categories")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  categoryId            String                 @db.Uuid
  sku                   String                 @unique
  name                  String
  slug                  String                 @unique
  description           String?
  type                  ProductType
  status                ProductStatus          @default(DRAFT)
  price                 Decimal                @db.Decimal(12, 2)
  costPrice             Decimal?               @db.Decimal(12, 2)
  stockQuantity         Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  size                  String?
  careLevel             String?
  temperatureRange      String?
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
  favorites             Favorite[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([categoryId, status])
  @@index([type, status])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([stockQuantity])
  @@map("products")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorites")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

model Order {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique
  // Client supplied idempotency key for safe checkout retries. Nullable keeps
  // older orders and non-checkout imports compatible; populated values are
  // globally unique and are never returned to the client.
  idempotencyKey   String?              @unique
  customerId      String?              @db.Uuid
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  note            String?
  status          OrderStatus          @default(PENDING)
  subtotal        Decimal              @db.Decimal(12, 2)
  shippingFee     Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal              @db.Decimal(12, 2)
  customer        User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  statusHistory   OrderStatusHistory[]
  returnRequests  ReturnRequest[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?
  providerPayload Json?
  // PayPal reservations are released after this deadline when checkout is
  // abandoned. Card payments are rejected until a real hosted processor is
  // configured, so every new checkout has a bounded reservation lifetime.
  checkoutExpiresAt DateTime?
  paidAt          DateTime?
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([status, checkoutExpiresAt])
  @@map("payments")
}

model ReturnRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  orderId            String              @db.Uuid
  customerId         String              @db.Uuid
  type               ReturnRequestType
  status             ReturnRequestStatus  @default(REQUESTED)
  reason             String
  amount             Decimal             @db.Decimal(12, 2)
  adminNote          String?
  resolutionNote     String?
  providerRefundId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer           User                @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model PaymentSettings {
  id            String   @id @default("default")
  country       String   @default("US")
  currency      String   @default("USD")
  defaultMethod String   @default("CARD")
  methods       Json
  providerConnections Json?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_settings")
}

model InventoryTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  productId   String                   @db.Uuid
  type        InventoryTransactionType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  referenceId String?
  note        String?
  createdBy   String?
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())

  @@index([productId, createdAt])
  @@index([referenceId])
  @@map("inventory_transactions")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  source         String    @default("storefront")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([subscribedAt])
  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  topic     String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("contact_messages")
}
