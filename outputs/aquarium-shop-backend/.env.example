NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aquarium:aquarium@localhost:5432/aquarium_shop?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-before-production-00000000
REFRESH_TOKEN_PEPPER=replace-with-another-64-random-characters-before-production-000000
ONE_TIME_TOKEN_PEPPER=replace-with-a-third-64-random-characters-before-production-0000000
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
JWT_ISSUER=aquarium-shop-api
JWT_AUDIENCE=aquarium-shop-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_NAME=aquarium_refresh
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
MFA_CHALLENGE_TTL_SECONDS=300
EMAIL_VERIFY_TTL_SECONDS=86400
PHONE_VERIFY_TTL_SECONDS=600
PASSWORD_RESET_TTL_SECONDS=900
FRONTEND_URL=http://localhost:3000
# Use smtp for real Gmail delivery. console is only for local development.
MAIL_MODE=console
MAIL_FROM=Aquarium Shop <no-reply@aquarium.local>
CONTACT_RECIPIENT=your-shop-email@example.com
# Gmail SMTP: enable 2-Step Verification, then create a 16-character App Password.
# Never use or commit your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMS_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
HEADERS_TIMEOUT_MS=60000
REQUIRE_ADMIN_MFA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
LOW_STOCK_THRESHOLD=5
DASHBOARD_CACHE_TTL_SECONDS=10

# Payment providers (keep secrets server-side; do not commit real values)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_SETUP_URL=https://developer.paypal.com/dashboard/applications/live
# direct = this shop's own PayPal account (recommended for one admin)
# connect = PayPal Partner Referrals, only after PayPal approves the platform partner
PAYPAL_INTEGRATION_MODE=direct
# Required for the real PayPal Connect/Partner Referrals onboarding flow.
# PayPal must approve the partner account and this return URL must be registered.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_RETURN_URL=https://your-domain.example/api/v1/payments/paypal/callback
PAYPAL_PARTNER_LOGO_URL=
CARD_PROCESSOR_READY=false
PAYMENT_RESERVATION_TTL_SECONDS=10800
