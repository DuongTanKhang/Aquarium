# Copy this file to .env for local Docker development. Never commit real secrets.
NODE_ENV=development
POSTGRES_DB=aquarium_shop
POSTGRES_USER=aquarium
POSTGRES_PASSWORD=change-this-local-password

# Host ports
API_PORT=4001
ADMIN_PORT=4173
CUSTOMER_PORT=4174

# The browser talks to the API through the same-origin Nginx proxy.
VITE_API_BASE_URL=/api/v1
CORS_ORIGIN=http://localhost:4173,http://localhost:4174
THROTTLE_GLOBAL_LIMIT=600
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_BLOCK_DURATION_MS=5000
FRONTEND_URL=http://localhost:4174

# Generate unique values before production (at least 64 random characters).
# These values boot local development; replace them with random secrets before production.
JWT_ACCESS_SECRET=dev-only-access-secret-change-before-production-0123456789abcdef
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-change-before-production-0123456789abcdef
ONE_TIME_TOKEN_PEPPER=dev-only-one-time-token-pepper-change-before-production-0123456789
MFA_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
REQUIRE_ADMIN_MFA=false

# Local verification is console-only. Production must use Gmail SMTP + Twilio.
MAIL_MODE=console
MAIL_FROM=Aquarium Shop <no-reply@aquarium.local>
CONTACT_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PayPal is intentionally empty in this template; sandbox is the safe default.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_INTEGRATION_MODE=direct
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_RETURN_URL=
PAYPAL_WEBHOOK_ID=

# Card checkout stays disabled until a PCI-compliant hosted processor is ready.
CARD_PROCESSOR_READY=false
PAYMENT_RESERVATION_TTL_SECONDS=10800
DATABASE_POOL_MAX=10
DASHBOARD_CACHE_TTL_SECONDS=10

# Optional one-shot admin seed (run with the seed profile).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
